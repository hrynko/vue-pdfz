{
  "name": "vue-pdfz",
  "version": "1.0.0",
  "description": "A customizable, i18n-ready, SSR-safe PDF viewer for Vue",
  "keywords": [
    "vue",
    "vuejs",
    "vue3",
    "pdf",
    "pdf-viewer"
  ],
  "repository": "github:hrynko/vue-pdfz",
  "license": "MIT",
  "author": "Aliaksei Hrynko (https://github.com/hrynko)",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./locales/*": {
      "types": "./dist/i18n/locales/*.d.ts",
      "import": "./dist/locales/*.js",
      "require": "./dist/locales/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm demo:dev",
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build",
    "build:lib": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo:samples": "node playground/generate-samples.mjs",
    "demo:dev": "node playground/generate-samples.mjs && vite --config playground/vite.config.ts",
    "demo:build": "node playground/generate-samples.mjs && vite build --config playground/vite.config.ts",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "vue-pdf-embed": "^2.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.6",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "happy-dom": "^15.11.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pdfjs-dist": "^5.7.284",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.2.6",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  },
  "peerDependencies": {
    "pdfjs-dist": "^5.7.284",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.10.2"
}
